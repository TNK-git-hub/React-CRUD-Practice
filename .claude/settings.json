{
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm test:*)",
      "Bash(pnpm --filter backend test:*)",
      "Bash(pnpm --filter frontend test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm exec stryker:*)",
      "Bash(pnpm --filter backend exec stryker:*)",
      "Bash(pnpm --filter frontend exec stryker:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/test/private/**)",
      "Edit(./**/test/**)",
      "Write(./**/test/**)",
      "Bash(cat */test/private:*)",
      "Bash(head */test/private:*)",
      "Bash(tail */test/private:*)",
      "Bash(less */test/private:*)",
      "Bash(ls */test/private:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-tests.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "pnpm lint" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh"
          }
        ]
      }
    ]
  }
}
