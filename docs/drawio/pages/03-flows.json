    { "id": "fl.l3.db", "label": "INSERT products\n+ tags · product_tags\n+ product_images", "x": 1440, "y": 575, "w": 240, "h": 90, "style": "db" },
    { "id": "fl.l3.result", "label": "navigate(/products/{id})", "x": 40, "y": 690, "w": 240, "h": 50, "style": "page" },
