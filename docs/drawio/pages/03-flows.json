    { "id": "fl.l5.api", "label": "deleteProduct(id)\nDELETE /products/:id", "x": 600, "y": 1065, "w": 240, "h": 60, "style": "api" },
    { "id": "fl.l5.ctrl", "label": "remove(@Param id, ParseIntPipe)", "x": 880, "y": 1065, "w": 240, "h": 60, "style": "backend" },
    { "id": "fl.l5.svc", "label": "findOne(id) → 404 if missing\nproductRepo.delete(id)\nreturns { …product, isDeleted, deletedOn }", "x": 1160, "y": 1050, "w": 240, "h": 90, "style": "backend" },
    { "id": "fl.l5.db", "label": "DELETE products\nCASCADE → images, reviews,\nproduct_tags", "x": 1440, "y": 1050, "w": 240, "h": 90, "style": "db" },
