    { "id": "fl.l4.init", "label": "EditProductForm (key = product.id)\nproductToForm(product)\nuseProductForm(initialForm, tags)", "x": 320, "y": 815, "w": 240, "h": 70, "style": "hook" },
    { "id": "fl.l4.dirty", "label": "getChangedFields() every render\n→ 'N thay đổi chưa lưu'\nSave enabled only when N > 0", "x": 320, "y": 915, "w": 240, "h": 70, "style": "hook" },
    { "id": "fl.l4.todo", "label": "Save → updateProduct(id, data)\nPATCH /products/:id\nNOT WIRED YET\n(onSubmit = preventDefault)", "x": 600, "y": 860, "w": 240, "h": 80, "style": "todo" },
    { "id": "fl.l4.ctrl", "label": "update(id, UpdateProductDto)\nPartialType: every field optional", "x": 880, "y": 865, "w": 240, "h": 70, "style": "backend" },
