# Copy file này thành backend/.env rồi điền giá trị thật:
#   cp backend/.env.example backend/.env
# File .env được dùng chung bởi backend (NestJS) và docker-compose (pnpm db:up).

# ---- Backend ----
PORT=3000
# URL của frontend, dùng cho CORS
FRONTEND_URL=http://localhost:5173

# ---- Database (Postgres trong docker) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# Bắt buộc. Tự đặt mật khẩu cho máy này; chỉ có hiệu lực lần đầu tạo DB
DB_PASSWORD=your_password_here
DB_NAME=crud_practice
