{
  "name": "singpass-myinfo-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Dealer Portal \u2013 Singpass Myinfo Auto Verify demo for ValueMax AutoFinance",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "dev": "node scripts/setup.ts && node --env-file=.env --watch server/index.ts",
    "start": "node scripts/setup.ts && node --env-file=.env server/index.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "screens": "node scripts/screenshots.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0"
  }
}
