    { "id": "fl.l4.db", "label": "UPDATE products\n(+ tags, images)", "x": 1440, "y": 855, "w": 240, "h": 90, "style": "db" },

    { "id": "fl.l5", "label": "5. Delete", "x": 20, "y": 1030, "w": 1680, "h": 220, "style": "zone" },
    { "id": "fl.l5.ui", "label": "CardMenu ⋮ → Xoá\nsetProductToDelete(product)", "x": 40, "y": 1065, "w": 240, "h": 60, "style": "page" },
