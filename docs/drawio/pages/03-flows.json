    { "id": "fl.l1", "label": "1. List · search · sort · paginate", "x": 20, "y": 80, "w": 1680, "h": 230, "style": "zone" },
    { "id": "fl.l1.ui", "label": "SearchForm / Sorting / PageNav\nhandleSearch · handleSort · setPage", "x": 40, "y": 115, "w": 240, "h": 60, "style": "page" },
    { "id": "fl.l1.url", "label": "updateParams()\nwrites q · page · sortBy · order to the URL\npath: / or /products/search", "x": 320, "y": 110, "w": 240, "h": 70, "style": "util" },
    { "id": "fl.l1.hook", "label": "useProducts({ page, query, sortBy, order })\nuseEffect re-runs → status: loading", "x": 320, "y": 215, "w": 240, "h": 70, "style": "hook" },
    { "id": "fl.l1.api", "label": "getProducts()\nGET /products?q&limit&skip\n&sortBy&order", "x": 600, "y": 215, "w": 240, "h": 70, "style": "api" },
    { "id": "fl.l1.ctrl", "label": "findAll(@Query QueryProductDto)\nlimit 1–100 · sortBy ∈ title/price/\nrating/stock · order asc/desc", "x": 880, "y": 215, "w": 240, "h": 70, "style": "backend" },
    { "id": "fl.l1.svc", "label": "findAndCount()\nILike %q% on title OR description\norder [sortBy] + id · skip / take", "x": 1160, "y": 215, "w": 240, "h": 70, "style": "backend" },
    { "id": "fl.l1.db", "label": "SELECT products", "x": 1440, "y": 205, "w": 240, "h": 90, "style": "db" },
