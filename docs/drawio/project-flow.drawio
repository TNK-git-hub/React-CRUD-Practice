    <diagram id="pages/04-database.json" name="4. Database">
        <mxGraphModel dx="675" dy="621" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="db.title" value="Database (TypeORM entities → Postgres tables)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="20" y="10" width="700" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="db.products" value="&lt;b&gt;products&lt;/b&gt;&lt;br&gt;id  PK serial&lt;br&gt;title  varchar&lt;br&gt;description  text?&lt;br&gt;category  varchar?&lt;br&gt;brand  varchar?&lt;br&gt;sku  varchar UNIQUE?&lt;br&gt;price  numeric(10,2)&lt;br&gt;discountPercentage  numeric(5,2) = 0&lt;br&gt;rating  numeric(3,2) = 0&lt;br&gt;stock  int = 0&lt;br&gt;minimumOrderQuantity  int = 1&lt;br&gt;availabilityStatus  varchar?&lt;br&gt;weight  numeric(10,2)?&lt;br&gt;dimensionsWidth / Height / Depth  numeric?&lt;br&gt;    (embedded Dimensions → { width, height, depth })&lt;br&gt;warrantyInformation  varchar?&lt;br&gt;shippingInformation  varchar?&lt;br&gt;returnPolicy  varchar?&lt;br&gt;barcode  varchar UNIQUE? (generated on create)&lt;br&gt;qrCode  varchar?&lt;br&gt;thumbnail  varchar?&lt;br&gt;createdAt / updatedAt  timestamp&lt;br&gt;reviewCount  virtual: COUNT(reviews)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="40" y="70" width="340" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="db.images" value="&lt;b&gt;product_images&lt;/b&gt;&lt;br&gt;id  PK&lt;br&gt;url  varchar&lt;br&gt;position  int = 0 (keeps image order)&lt;br&gt;productId  FK → products  ON DELETE CASCADE" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="480" y="70" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="db.reviews" value="&lt;b&gt;reviews&lt;/b&gt;&lt;br&gt;id  PK&lt;br&gt;rating  int&lt;br&gt;comment  text?&lt;br&gt;date  timestamp&lt;br&gt;reviewerName  varchar&lt;br&gt;reviewerEmail  varchar&lt;br&gt;productId  FK → products  ON DELETE CASCADE" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="480" y="200" width="300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="db.productTags" value="&lt;b&gt;product_tags (join table)&lt;/b&gt;&lt;br&gt;productId  FK → products&lt;br&gt;tagId  FK → tags" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="480" y="390" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="db.tags" value="&lt;b&gt;tags&lt;/b&gt;&lt;br&gt;id  PK&lt;br&gt;name  varchar UNIQUE" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="880" y="390" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="db.notes" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• synchronize: true → tables are auto-created from the entities&lt;br&gt;• numeric columns use a transformer: string → number&lt;br&gt;• tags: findOrCreateTags() reuses existing names&lt;br&gt;• duplicate sku / barcode → 409 Conflict (pg code 23505)&lt;br&gt;• deleting a product cascades to images, reviews, product_tags" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fffde7;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="880" y="70" width="400" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="db.e.products-images" value="1 – N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;" parent="1" source="db.products" target="db.images" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="db.e.products-reviews" value="1 – N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;" parent="1" source="db.products" target="db.reviews" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="db.e.products-productTags" value="1 – N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;" parent="1" source="db.products" target="db.productTags" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="db.e.tags-productTags" value="1 – N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;" parent="1" source="db.tags" target="db.productTags" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
