    { "id": "fl.l2", "label": "2. Product detail", "x": 20, "y": 330, "w": 1680, "h": 200, "style": "zone" },
    { "id": "fl.l2.ui", "label": "ProductCard link\n→ /products/:id", "x": 40, "y": 365, "w": 240, "h": 60, "style": "page" },
    { "id": "fl.l2.hook", "label": "useProduct(id)\nstatus: loading → success / error / notfound", "x": 320, "y": 365, "w": 240, "h": 60, "style": "hook" },
    { "id": "fl.l2.api", "label": "getProductById(id)\nGET /products/:id", "x": 600, "y": 365, "w": 240, "h": 60, "style": "api" },
