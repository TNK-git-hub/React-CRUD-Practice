crash.log

# Hidden (private) tests: only on this machine, never committed
**/test/private/

# Mutation testing results
reports/
.stryker-tmp/

# Python environment for webapp-testing (Playwright)
.venv/

# Build output / generated files
.next/
next-env.d.ts
*.tsbuildinfo

# Agent job logs (saved locally when a k8s job runs)
k8s/agents/logs/

# Task files the main session writes when dispatching (only the sample is kept)
k8s/agents/tasks/*
!k8s/agents/tasks/EXAMPLE.md

# Python cache of the harness scripts (.specify/scripts, .claude/hooks)
__pycache__/
*.pyc
