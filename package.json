{
  "name": "react-crud-practice",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "db:up": "docker compose --env-file backend/.env up -d",
    "db:down": "docker compose --env-file backend/.env down",
    "dev:fe": "pnpm --filter frontend dev",
    "dev:be": "pnpm --filter backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  }
}
