#!/bin/bash
# Chạy 1 lần khi EC2 khởi động lần đầu. Log: /var/log/user-data.log
set -euxo pipefail
exec > >(tee /var/log/user-data.log) 2>&1

# ---- Swap 2GB: t3.micro chỉ có 1GB RAM, không đủ để build ----
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile swap swap defaults 0 0' >> /etc/fstab
fi

# ---- Docker + compose + buildx ----
dnf install -y docker git
systemctl enable --now docker
usermod -aG docker ec2-user

ARCH=$(uname -m)                                   # x86_64 | aarch64
case "$ARCH" in x86_64) GOARCH=amd64 ;; aarch64) GOARCH=arm64 ;; esac
PLUGINS=/usr/local/lib/docker/cli-plugins
mkdir -p "$PLUGINS"

curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$ARCH" \
  -o "$PLUGINS/docker-compose"

BUILDX_TAG=$(curl -fsSLI -o /dev/null -w '%%{url_effective}' https://github.com/docker/buildx/releases/latest | sed 's#.*/##')
curl -fsSL "https://github.com/docker/buildx/releases/download/$BUILDX_TAG/buildx-$BUILDX_TAG.linux-$GOARCH" \
  -o "$PLUGINS/docker-buildx"

chmod +x "$PLUGINS"/*

# ---- Lấy code + chạy app ----
APP_DIR=/opt/app
git clone --depth 1 --branch "${git_branch}" "${repo_url}" "$APP_DIR"

cat > "$APP_DIR/.env" <<'EOF'
DB_USER=postgres
DB_PASSWORD=${db_password}
DB_NAME=crud_practice
VITE_API_URL=${vite_api_url}
EOF
chmod 600 "$APP_DIR/.env"

cd "$APP_DIR"
docker compose -f docker-compose.prod.yml up -d --build
