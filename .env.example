# Port the app listens on (0.0.0.0, so phones on the same Wi-Fi can reach it)
PORT=3000
# Base URL put in the emails. Use your LAN IP (http://192.168.x.x:3000) or a tunnel URL
# (cloudflared / ngrok). Empty = auto-detected LAN address.
PUBLIC_BASE_URL=
# AES-256-GCM key for stored Myinfo data (64 hex chars). `npm run setup` generates one.
MYINFO_ENCRYPTION_KEY=
# Myinfo gateway:
#   "http"      (default) separate Myinfo gateway service (mock-gateway/ in front of MockPass). It hosts the customer's
#               Review / Submit pages and pushes the data back by signed webhook to /api/gateway/webhook.
#               Started automatically on GW_PORT and proxied through this app (/gw/*). For the real gateway later:
#               set GATEWAY_URL, GW_CLIENT_ID / GW_CLIENT_SECRET, WEBHOOK_SECRET and GATEWAY_AUTOSTART=false.
#   "mockpass"  this app is the Myinfo client of MockPass itself (no separate gateway)
#   "simulated" built-in fake Singpass screens
GATEWAY=http
GW_PORT=4000
GATEWAY_URL=
GATEWAY_AUTOSTART=true
GW_CLIENT_ID=VMAF-AUTOFIN-DEMO
GW_CLIENT_SECRET=demo-client-secret
# Shared secret for the webhook HMAC signature (same value on both sides)
WEBHOOK_SECRET=demo-webhook-secret
MOCKPASS_PORT=5156
# Show the customer the review screen before "Submit Application" (D-31)
MYINFO_SHOW_REVIEW=true
# Link validity in hours
LINK_TTL_HOURS=72
# SMTP. Empty SMTP_HOST = emails are only printed to the log and kept in the Demo Control outbox.
# Mailpit (docker compose up mailpit): SMTP_HOST=localhost SMTP_PORT=1025
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=<you>@gmail.com
#        SMTP_PASS=<16-char app password from https://myaccount.google.com/apppasswords> MAIL_FROM=<you>@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ValueMax AutoFinance (Demo) <no-reply@example.com>"
